@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <p class="nav-link text-dark" title="Manage">Hello @User.Identity.Name</p>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Auth" asp-controller="Auth" asp-action="SignOut" asp-route-returnUrl="/" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">SignOut</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Auth" asp-controller="Auth" asp-action="SignIn">SignIn</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Auth" asp-controller="Auth" asp-action="SignUp">SignUp</a>
        </li>
    }
</ul>
