@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="dropdown">
            <a class="btn btn-secondary dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Hello @User.Identity.Name
            </a>

            <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-area="Auth" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                <li><a class="dropdown-item" asp-area="Auth" asp-controller="Auth" asp-action="SignOut" asp-route-returnUrl="/">SignOut</a></li>
            </ul>
        </div>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Auth" asp-controller="Auth" asp-action="SignIn">SignIn</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Auth" asp-controller="Auth" asp-action="SignUp">SignUp</a>
        </li>
    }
</ul>
