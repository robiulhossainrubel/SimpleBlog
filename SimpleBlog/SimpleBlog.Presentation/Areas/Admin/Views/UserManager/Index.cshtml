@model List<AppUser>
@{
    ViewData["Title"] = "User List";
}
<div class="container-fluid">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Email</th>
                <th scope="col">Role</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <th>@user.Name</th>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>
                        @if(user.LockoutEnd != null)
                        {
                            <a asp-controller="UserManager" asp-action="BlockUnBlock" asp-route-id="@user.Id" class="btn btn-danger"><i class="bi bi-lock"></i></a>
                        }
                        else
                        {
                            <a asp-controller="UserManager" asp-action="BlockUnBlock" asp-route-id="@user.Id" class="btn btn-success"><i class="bi bi-unlock"></i></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>